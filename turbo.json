{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_GOOGLE_MAPS_KEY",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_JWKS_URL",
        "SUPABASE_DISABLE_EMAIL_CONFIRMATION_FOR_TESTING",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_API_KEY_SID",
        "TWILIO_API_KEY_SECRET",
        "TWILIO_FROM_NUMBER",
        "OPENAI_API_KEY",
        "FAL_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_PRICE_PRO_MONTH",
        "STRIPE_PRICE_PRO_YEAR",
        "STRIPE_PRICE_FEATURED_MONTH",
        "STRIPE_PRICE_FEATURED_YEAR",
        "BLOG_MODEL",
        "BLOG_AUTO_PUBLISH",
        "BLOG_POSTS_PER_DAY",
        "APPLE_TEAM_ID",
        "ANDROID_SHA256_FINGERPRINT",
        "GEMINI_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
