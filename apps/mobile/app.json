{
  "expo": {
    "name": "čārana",
    "slug": "charana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "charana",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ca.charana.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:charana.ca",
        "applinks:www.charana.ca"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f6f1e8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ca.charana.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "charana.ca",
              "pathPrefix": "/businesses"
            },
            {
              "scheme": "https",
              "host": "www.charana.ca",
              "pathPrefix": "/businesses"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f1e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}
