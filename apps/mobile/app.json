{
  "expo": {
    "name": "GOPLAZA",
    "slug": "charana",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["goplaza", "charana"],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ca.charana.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:goplaza.ca",
        "applinks:www.goplaza.ca",
        "applinks:charana.ca",
        "applinks:www.charana.ca"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "GOPLAZA"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A1831",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ca.charana.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "goplaza.ca",
              "pathPrefix": "/businesses"
            },
            {
              "scheme": "https",
              "host": "www.goplaza.ca",
              "pathPrefix": "/businesses"
            },
            {
              "scheme": "https",
              "host": "charana.ca",
              "pathPrefix": "/businesses"
            },
            {
              "scheme": "https",
              "host": "www.charana.ca",
              "pathPrefix": "/businesses"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f1e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "گوپلازا برای ضبط پیشنهاد صوتی شما به میکروفون نیاز دارد."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ddda648e-ce1b-4e47-9d03-c00dfac61e71"
      }
    },
    "owner": "ashavid"
  }
}