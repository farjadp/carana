{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": [
    "Host redirects are configured at the domain level in the Vercel project,",
    "not here: charana.ca is canonical and www.charana.ca, carana.ca and",
    "www.carana.ca all 308 to it. Duplicating those rules in this file sent",
    "traffic back the other way and produced a redirect loop."
  ],

  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        }
      ]
    }
  ]
}
