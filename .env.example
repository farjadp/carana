# ============================================================================
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================================

# --- Supabase: public (safe to expose to the browser) ----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server-only -------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role. Bypasses RLS — server-side only, never ship to a client
# and never hard-code in a script.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- AI ---------------------------------------------------------------------
OPENAI_API_KEY=

# --- Maps -------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- App --------------------------------------------------------------------
# Canonical origin. carana.ca must 301-redirect here, never serve a copy.
# Absolute origin used to build auth redirect links (password reset, email
# confirmation). Must be the real origin in production.
NEXT_PUBLIC_BASE_URL=https://charana.ca

# --- Testing only -----------------------------------------------------------
# When "true", /api/auth/signup creates pre-confirmed users via the admin API,
# skipping email confirmation. MUST stay false/unset in production.
SUPABASE_DISABLE_EMAIL_CONFIRMATION_FOR_TESTING=false
