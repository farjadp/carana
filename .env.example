# ============================================================================
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================================

# --- Supabase: public (safe to expose to the browser) ----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server-only -------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role. Bypasses RLS — server-side only, never ship to a client
# and never hard-code in a script.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- AI ---------------------------------------------------------------------
OPENAI_API_KEY=

# --- Email (Resend) ---------------------------------------------------------
# Server only. charana.ca is the verified sending domain until goplaza.ca is
# verified in Resend (see REBRAND_EXTERNAL_ACTIONS.md); the display name is
# already GOPLAZA.
RESEND_API_KEY=
EMAIL_FROM="GOPLAZA <noreply@charana.ca>"

# --- SMS (Twilio) -----------------------------------------------------------
# Server only. Uses an API Key, not the account auth token, so it can be
# revoked without touching the account. FROM must be a Twilio number you own.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Maps -------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- App --------------------------------------------------------------------
# Canonical origin. charana.ca, www.goplaza.ca and carana.ca must 308-redirect
# here, never serve a copy.
# Absolute origin used to build auth redirect links (password reset, email
# confirmation). Must be the real origin in production.
NEXT_PUBLIC_BASE_URL=https://goplaza.ca

# --- Testing only -----------------------------------------------------------
# When "true", /api/auth/signup creates pre-confirmed users via the admin API,
# skipping email confirmation. MUST stay false/unset in production.
SUPABASE_DISABLE_EMAIL_CONFIRMATION_FOR_TESTING=false
